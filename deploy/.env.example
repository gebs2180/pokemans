# Copy to .env on the server (chmod 600) and fill in. Never commit .env. See docs/hosting.md for where each value comes from.

# Site: beta.rawmark.app (live since 2026-10-28; its A record points at the server),
# or <server-ip-with-dashes>.sslip.io to test before DNS is ready.
SITE_ADDRESS=beta.rawmark.app
ACME_EMAIL=you@example.com

# Postgres (generate: openssl rand -base64 32 | tr -d '/+=')
POSTGRES_PASSWORD=

# Auth0 (docs/auth.md). Issuer keeps its trailing slash.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_ISSUER_URI=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.pokemans.app
AUTH0_SPA_CLIENT_ID=

# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PHOTO_BUCKET=pokemans-photos
R2_BACKUP_BUCKET=pokemans-backups
# App token: Object Read & Write on the photo bucket only.
R2_APP_ACCESS_KEY_ID=
R2_APP_SECRET_ACCESS_KEY=
# Backup tokens: Object Read only on the photo bucket; Object Read & Write on the backup bucket only.
R2_BACKUP_READ_ACCESS_KEY_ID=
R2_BACKUP_READ_SECRET_ACCESS_KEY=
R2_BACKUP_WRITE_ACCESS_KEY_ID=
R2_BACKUP_WRITE_SECRET_ACCESS_KEY=

# Backups: time of day (UTC). How long they're kept is the backup bucket's lock and
# lifecycle rules in R2 (docs/hosting.md, step 3), not a setting here.
BACKUP_AT=03:30
# Optional: healthchecks.io ping URL; you get an email when a nightly backup doesn't report in.
BACKUP_HEALTHCHECK_URL=
# Restore test: restores the newest dump into a throwaway database straight after the backup on these
# UTC weekdays ("Sun", "Sun,Wed", "daily", or "off"), compares row counts and checks the photo copies.
RESTORE_TEST_DAYS=Sun
# Optional: healthchecks.io ping URL for the restore test (period 7 days, grace 1 day for weekly).
RESTORE_TEST_HEALTHCHECK_URL=

# Optional off-site copy (deep review A1): every dump and photo also goes to a second provider in another
# account, so losing the Cloudflare account doesn't lose the backups. Off unless BOTH are set; setting
# only one fails the backup. OFFSITE_REMOTE is an rclone connection string ending in ':', and
# OFFSITE_PATH the bucket or folder under it. Examples (deploy/backup/README.md has the setup):
#   Backblaze B2 (application key limited to one bucket, without deleteFiles):
#     OFFSITE_REMOTE=:b2,account=<keyID>,key=<applicationKey>:
#     OFFSITE_PATH=rawmark-offsite
#   Hetzner Storage Box (sub-account, SFTP on port 23; pass is the output of `rclone obscure '<password>'`):
#     OFFSITE_REMOTE=:sftp,host=uNNNNNN-subN.your-storagebox.de,user=uNNNNNN-subN,port=23,pass=<obscured>:
#     OFFSITE_PATH=rawmark
OFFSITE_REMOTE=
OFFSITE_PATH=

# Errors: Sentry project DSN (free Developer plan). Empty = Sentry off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=beta

# Optional features, off by default.
CARD_READER_ENABLED=false
ANTHROPIC_API_KEY=
EASYPOST_ENABLED=false
EASYPOST_API_KEY=
# Notification emails through Resend, from an address on the verified rawmark.app domain.
NOTIFY_EMAIL_ENABLED=false
RESEND_API_KEY=
NOTIFY_EMAIL_FROM="Rawmark <notify@rawmark.app>"
# Pre-grading: testers' photos go to the provider. Check docs/pregrade-providers.md first;
# opt the CardGrade account out of AI training before enabling it.
CARDGRADE_ENABLED=false
CARDGRADE_API_KEY=
# Our own centering measurement (no key, runs in the app). Off until checked against returned grades.
CENTERING_ENABLED=false
# Sold prices from PokeTrace (written permission 2026-11-07, docs/price-data-sources.md). The nightly
# pull (06:30 UTC) runs only with PRICING_INGESTION_ENABLED; each card is mapped by an admin first.
POKETRACE_ENABLED=false
POKETRACE_API_KEY=
PRICING_INGESTION_ENABLED=false
# Optional: healthchecks.io ping URL for the nightly pricing run (period 1 day, grace 2 hours). It gets the
# rows inserted on success, and /fail when the run fails or the enabled source inserted nothing.
PRICING_HEALTHCHECK_URL=
# On by default: offers show what each grade recently sold for. Set false if the price data's licence
# doesn't allow showing sold prices; a restart applies it.
SHOW_SOLD_PRICES=true
